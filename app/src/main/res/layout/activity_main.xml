<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/selection"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="10dp"
        android:layout_margin="10dp"
       >
    </TextView>

    <Spinner
        android:id="@+id/spiner_all"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="20dp"
        android:layout_margin="20dp"
        android:background="@drawable/main_menu"
        android:translationZ="4dp"
        />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="@drawable/asfalt3"
        />


    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:background="@drawable/camoro"
        />




    <ImageButton
        android:id="@+id/loginBtnStart"
        android:layout_width="120dp"
        android:layout_height="35dp"
        android:layout_alignParentStart="true"
        android:layout_margin="50dp"
        android:layout_marginStart="30dp"
        android:src="@drawable/login4" />


    <TextView
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_marginTop="260dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/dreamitul"
        android:scaleType="fitXY"
        />

    <ImageButton
        android:id="@+id/Button_gallery"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_margin="30dp"
        android:layout_alignParentRight="true"
        android:scaleType="fitXY"
        android:background="@drawable/asfalt3"
        android:src="@drawable/gallery_btn" />
</RelativeLayout>